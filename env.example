# PORT: Port the HTTP server listens on. Most hosting platforms (Render included)
# inject this automatically; you normally don't need to set it yourself.
PORT=3000

# DATA_DIR: Directory where the SQLite database file is stored.
# In production, point this at a persistent disk mount (e.g. Render Disk at /data)
# so data survives restarts and redeploys. Defaults to ./data locally.
DATA_DIR=./data

# ADMIN_RESET_TOKEN: Required to call POST /api/reset-db (wipes all data).
# Leave unset to disable the endpoint entirely. Set a long random value and
# send it via the "x-admin-token" header if you need this maintenance action.
ADMIN_RESET_TOKEN=
